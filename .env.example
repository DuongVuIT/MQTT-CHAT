# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
DATABASE_URL=postgresql://mqtt:mqtt@localhost:5432/mqtt_chat?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MQTT (server-side, TCP) ----
MQTT_URL=mqtt://localhost:1883
# MQTT (browser-side, WebSocket) — optional override. Clients default to the
# same-origin public path ws://<host>/mqtt served by the gateway on :3000.
#MQTT_WS_URL=ws://localhost:3000/mqtt

# ---- Object storage (MinIO dev / S3-compatible prod; INTERNAL ONLY) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mqtt-chat-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Services ----
# Internal API origin (gateway proxies /api/* here). Browsers use relative
# /api paths by default and never need this.
API_URL=http://localhost:3001/api
# Optional browser overrides — same-origin defaults apply when unset:
#/api for REST, ws://<host>/mqtt for realtime.
#NEXT_PUBLIC_API_URL=/api
#NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:3000/mqtt

# ---- Gateway (public origin :3000; everything else is internal) ----
GATEWAY_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3100
API_ORIGIN=http://127.0.0.1:3001
EMQX_WS_ORIGIN=http://127.0.0.1:8083

# ---- Mobile (optional overrides; derived from platform otherwise) ----
# Public gateway "host:port" as reachable from the device/simulator.
#MQTT_CHAT_PUBLIC_HOST=localhost:3000

# ---- Ports (reference) ----
# PUBLIC:  gateway 3000  ← the only port users open
# INTERNAL: web 3100 | api 3001 | emqx dashboard 18083
#   mqtt tcp 1883 | mqtt ws 8083 | postgres 5432 | redis 6379 | minio 9000/9001
