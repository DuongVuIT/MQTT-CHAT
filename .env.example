# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
DATABASE_URL=postgresql://mqtt:mqtt@localhost:5432/mqtt_chat?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MQTT (server-side, TCP) ----
MQTT_URL=mqtt://localhost:1883
# MQTT (browser-side, WebSocket)
MQTT_WS_URL=ws://localhost:8083/mqtt

# ---- Object storage (MinIO dev / S3-compatible prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mqtt-chat-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Services ----
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:8083/mqtt

# ---- Ports (reference) ----
# web 3000 | api 3001 | admin 3002
# mqtt tcp 1883 | ws 8083 | emqx dashboard 18083
# postgres 5432 | redis 6379 | minio 9000/9001